pragma language_version 0.23;
import CompactStandardLibrary;

// Experimental mUSDC mimic — no peg, no value. Never deploy to Mainnet.
// Insert-only ledgers: Undeployed dust wallet panics on map key overwrites.
// Transfer appends a credit row keyed by nonce; faucet credits the signer once.
// Access control: transfer requires faucet_claimed.member(fromPk) — not an empty-hash check.

export ledger credits: Map<Bytes<32>, Uint<64>>;
export ledger credit_to: Map<Bytes<32>, Bytes<32>>;
export ledger faucet_claimed: Set<Bytes<32>>;
export ledger spent_nonces: Set<Bytes<32>>;

witness localSecretKey(): Bytes<32>;

export circuit faucet(): [] {
  const sk = localSecretKey();
  const pk = persistentHash<Vector<2, Bytes<32>>>([pad(32, "musdc:signer:v1"), sk]);
  assert(!faucet_claimed.member(disclose(pk)), "already claimed");
  faucet_claimed.insert(disclose(pk));
  credits.insert(disclose(pk), disclose(10000000 as Uint<64>));
  credit_to.insert(disclose(pk), disclose(pk));
}

export circuit transfer(to: Bytes<32>, amount: Uint<64>, nonce: Bytes<32>): [] {
  const sk = localSecretKey();
  const fromPk = persistentHash<Vector<2, Bytes<32>>>([pad(32, "musdc:signer:v1"), sk]);
  assert(!spent_nonces.member(disclose(nonce)), "nonce spent");
  assert(amount > 0 as Uint<64>, "amount zero");
  assert(faucet_claimed.member(disclose(fromPk)), "signer");
  spent_nonces.insert(disclose(nonce));
  credits.insert(disclose(nonce), disclose(amount));
  credit_to.insert(disclose(nonce), disclose(to));
}
